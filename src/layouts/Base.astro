---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Veekshith — dev portfolio' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Veekshith — Discord bots, Minecraft tools, and other fun stuff." />
  </head>
  <body>
    <slot />

    <button id="music-toggle" class="music-btn" aria-label="Toggle music" title="Toggle ambient music">
      <svg class="music-icon music-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
      </svg>
      <svg class="music-icon music-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18V5l12-2v13"/>
        <circle cx="6" cy="18" r="3"/>
        <circle cx="18" cy="16" r="3"/>
        <line x1="1" y1="1" x2="23" y2="23"/>
      </svg>
    </button>

    <script>
(function() {
  let ctx = null;
  let masterGain = null;
  let isPlaying = false;
  let isMuted = false;
  let nodes = [];
  let arpeggioTimer = null;
  let effectsTimer = null;
  let started = false;

  const btn = document.getElementById('music-toggle');

  function log(msg) {
    console.log('♪', msg);
  }

  async function init() {
    if (ctx) return;
    ctx = new (window.AudioContext || window.webkitAudioContext)();
    masterGain = ctx.createGain();
    masterGain.gain.value = 0.12;
    masterGain.connect(ctx.destination);
    log('audio context ready');
  }

  function createNoiseBuffer() {
    const bufSize = ctx.sampleRate * 2;
    const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < bufSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }
    return buf;
  }

  function startPad() {
    const osc1 = ctx.createOscillator();
    const osc2 = ctx.createOscillator();
    const gain = ctx.createGain();
    const filter = ctx.createBiquadFilter();

    osc1.type = 'sawtooth';
    osc1.frequency.value = 55;
    osc2.type = 'sine';
    osc2.frequency.value = 110;

    filter.type = 'lowpass';
    filter.frequency.value = 180;
    filter.Q.value = 4;

    gain.gain.setValueAtTime(0, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.03, ctx.currentTime + 3);

    osc1.connect(filter);
    osc2.connect(filter);
    filter.connect(gain);
    gain.connect(masterGain);

    const lfo = ctx.createOscillator();
    const lfoGain = ctx.createGain();
    lfo.frequency.value = 0.08;
    lfoGain.gain.value = 30;
    lfo.connect(lfoGain);
    lfoGain.connect(filter.frequency);
    lfo.start();

    osc1.start();
    osc2.start();
    nodes.push(osc1, osc2, lfo);

    const noiseSrc = ctx.createBufferSource();
    noiseSrc.buffer = createNoiseBuffer();
    noiseSrc.loop = true;
    const noiseFilter = ctx.createBiquadFilter();
    noiseFilter.type = 'bandpass';
    noiseFilter.frequency.value = 80;
    noiseFilter.Q.value = 2;
    const noiseGain = ctx.createGain();
    noiseGain.gain.value = 0.008;
    noiseSrc.connect(noiseFilter);
    noiseFilter.connect(noiseGain);
    noiseGain.connect(masterGain);
    noiseSrc.start();
    nodes.push(noiseSrc);
  }

  const pentatonic = [220, 261.63, 293.66, 349.23, 392, 440, 523.25, 587.33, 659.25, 783.99];
  let noteIdx = 0;

  function scheduleArpeggio() {
    if (!isPlaying) return;
    const freq = pentatonic[noteIdx % pentatonic.length];
    noteIdx = (noteIdx + 1) % pentatonic.length;

    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(0, ctx.currentTime);
    gain.gain.linearRampToValueAtTime(0.015, ctx.currentTime + 0.3);
    gain.gain.linearRampToValueAtTime(0.001, ctx.currentTime + 1.5);
    osc.connect(gain);
    gain.connect(masterGain);
    osc.start();
    osc.stop(ctx.currentTime + 1.6);

    const delay = 1200 + Math.random() * 600;
    arpeggioTimer = setTimeout(scheduleArpeggio, delay);
  }

  function scheduleEffect() {
    if (!isPlaying) return;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = Math.random() > 0.5 ? 'square' : 'sine';
    osc.frequency.value = 600 + Math.random() * 800;
    gain.gain.setValueAtTime(0.008, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.08);
    osc.connect(gain);
    gain.connect(masterGain);
    osc.start();
    osc.stop(ctx.currentTime + 0.1);

    const delay = 5000 + Math.random() * 7000;
    effectsTimer = setTimeout(scheduleEffect, delay);
  }

  function playStartupSound() {
    const notes = [523.25, 659.25, 783.99, 1046.5];
    notes.forEach((freq, i) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.value = freq;
      gain.gain.setValueAtTime(0, ctx.currentTime + i * 0.12);
      gain.gain.linearRampToValueAtTime(0.04, ctx.currentTime + i * 0.12 + 0.05);
      gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.12 + 0.3);
      osc.connect(gain);
      gain.connect(masterGain);
      osc.start(ctx.currentTime + i * 0.12);
      osc.stop(ctx.currentTime + i * 0.12 + 0.35);
    });
  }

  function startMusic() {
    if (isPlaying) return;
    isPlaying = true;
    isMuted = false;

    if (ctx.state === 'suspended') ctx.resume();

    startPad();
    playStartupSound();
    setTimeout(scheduleArpeggio, 1800);
    setTimeout(scheduleEffect, 3000);

    btn.classList.add('playing');
    log('ambient started');
  }

  function stopMusic() {
    isPlaying = false;
    clearTimeout(arpeggioTimer);
    clearTimeout(effectsTimer);
    nodes.forEach(n => { try { n.stop(); } catch(e) {} });
    nodes = [];
    if (ctx && ctx.state !== 'closed') {
      ctx.close().catch(() => {});
      ctx = null;
      masterGain = null;
    }
    btn.classList.remove('playing');
    log('stopped');
  }

  function toggleMute() {
    if (!ctx || !masterGain) return;
    isMuted = !isMuted;
    masterGain.gain.value = isMuted ? 0 : 0.12;
    btn.classList.toggle('muted', isMuted);
    log(isMuted ? 'muted' : 'unmuted');
  }

  async function handleToggle() {
    if (!started) {
      await init();
      startMusic();
      started = true;
      btn.classList.add('started');
      return;
    }
    if (isPlaying) {
      toggleMute();
    } else {
      await init();
      startMusic();
    }
  }

  if (btn) {
    btn.addEventListener('click', handleToggle);
  }

  log('ready — click the music note to play');
})();

// Scroll reveal
(function() {
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    });
  } else {
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal').forEach(el => el.classList.add('visible'));
    });
  }
})();
    </script>
  </body>
</html>
