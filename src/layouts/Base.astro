---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Veekshith — dev portfolio' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content="Veekshith — Discord bots, Minecraft tools, and other fun stuff." />
  </head>
  <body>
    <slot />
  </body>
</html>
