---
import Base from '../layouts/Base.astro';

const skills = [
  {
    title: 'Discord.js',
    desc: 'Bots that don\'t fall over when you have a thousand servers. Slash commands, tickets, giveaways — I\'ve built it all.',
    tags: ['TypeScript', 'Redis', 'Sharding'],
    logo: 'https://cdn.discordapp.com/attachments/1481874713704792186/1525812618093137930/LnBuZw.png?ex=6a54bf3c&is=6a536dbc&hm=39b1231b896f4ecf95e7e21e12c0c76fad303bcb844748695fea7910d99b2987&',
  },
  {
    title: 'Java / Spigot',
    desc: 'Plugins that actually perform. Minigames, economies, staff tools — whatever the server needs.',
    tags: ['Java', 'PaperMC', 'Bukkit API'],
    logo: 'https://cdn.discordapp.com/attachments/1481874713704792186/1525812792148492308/cG5n.png?ex=6a54bf65&is=6a536de5&hm=db7935cfd32fa68970f55f6a6d0f89ebc528a8fea6409610501cf4a6bf07c03f&',
  },
  {
    title: 'Web Dev',
    desc: 'Dashboards, landing pages, skin viewers — if it needs to exist on the web, I can put it there.',
    tags: ['Astro', 'React', 'REST APIs'],
  },
  {
    title: 'Infra & DevOps',
    desc: 'Docker, CI/CD, Linux servers. I make sure the stuff I build actually stays running.',
    tags: ['Docker', 'GitHub Actions', 'Linux'],
    logo: 'https://cdn.discordapp.com/attachments/1481874713704792186/1525813028539334697/NS5wbmc.png?ex=6a54bf9e&is=6a536e1e&hm=f4c93fbe6e7c596cedb76cdc17e27bd036a6807d3634a7e08ad6bdd0fda84ef4&',
  },
  {
    title: 'Fabric Mods',
    desc: 'Lightweight Fabric mods for survival QoL — tool packs and automation helpers.',
    tags: ['Java', 'Fabric', 'Mixin'],
    logo: 'https://cdn.discordapp.com/attachments/1481874713704792186/1525813424389619942/P3Jhdz10cnVl.png?ex=6a54bffc&is=6a536e7c&hm=eb7c5113cc00cb123176d2b9701ffb374f1f4c271657691e1670447bb6ba9321&',
  },
  {
    title: 'Management',
    desc: 'Running SMPs end to end — staff, community, and the dev roadmap. Keeping servers organized so the building actually ships.',
    tags: ['Team Lead', 'Community', 'Roadmaps'],
  },
];

const projects = [
  {
    name: 'Vanilla-Core',
    type: 'Minecraft Plugin',
    desc: 'All-in-one SMP plugin. Essentials commands, staff tools, economy — basically the backbone for a survival server. Live right now but I\'m still chasing bugs.',
    features: [
      'Homes, warps, tpa with SQLite persistence',
      'Staff tools: freeze, vanish, invsee, staff chat',
      'Player economy — balance, pay, shop commands',
      'Spawn and random tps with cooldowns so nobody abuses em',
    ],
    tech: ['Java', 'Spigot', 'PaperMC', 'SQLite', 'Gradle'],
    github: 'https://github.com/veekshith177-bot/Vanilla-Core.git',
    status: 'alpha',
    badges: ['released', 'alpha'],
  },
  {
    name: 'Apex Building Bot',
    type: 'Discord Bot',
    desc: 'Discord bot for Donut SMP and Apex. Tickets, moderation, giveaways, builder apps — the works. Still running in production.',
    features: [
      'Ticket panels: General, Build, Digout, Refund, Regear',
      'Moderation: warn, mute, tempban, slowmode, lock',
      'Split or Steal giveaways with daily auto runs',
      'DM-based builder ratings so staff can review builders',
    ],
    tech: ['TypeScript', 'Node.js', 'Discord.js v14', 'better-sqlite3'],
    github: 'https://github.com/veekshith177-bot/Apex-Building-Bot',
    live: 'https://discord.gg/n7qY76PMH7',
    status: 'released',
    badges: ['released'],
  },
  {
    name: 'Minecraft Skin Gallery',
    type: 'Web App',
    desc: 'Type any Minecraft username and see their skin rendered in 3D. 6 animations, cape support, auto detects Alex vs Steve arms. Kinda fun to mess with.',
    features: [
      'Real-time 3D rendering with skinview3d + Three.js',
      '6 animations: Walk, Run, Fly, Wave, Crouch, Swim',
      'Auto-detects Alex vs Steve arm models',
      'Cape support if the player has one',
    ],
    tech: ['Astro', 'Three.js', 'skinview3d', 'PlayerDB API'],
    github: 'https://github.com/veekshith177-bot/Minecraft-Skin-Gallery',
    live: 'https://minecraft-skin-gallery.netlify.app',
    status: 'released',
    badges: ['released'],
  },
];

const fabricLogo = 'https://cdn.discordapp.com/attachments/1481874713704792186/1525813424389619942/P3Jhdz10cnVl.png?ex=6a54bffc&is=6a536e7c&hm=eb7c5113cc00cb123176d2b9701ffb374f1f4c271657691e1670447bb6ba9321&';

const archived = [
  {
    name: 'DonutTools',
    type: 'Fabric Mod (Lost)',
    desc: 'A bundled Fabric mod for Donut SMP that packed a load of survival QoL into one pack. The source is gone now, but the ideas stuck.',
    features: [
      'Shard Picaxe — breaks a 9x9 area of blocks in a single swing',
      'Heavy Logics — heavier automation and logic helpers',
      'Tree Chopper & Axe — fells whole trees in one hit',
      'Customizable time-limit of use: both the Shard Picaxe and Tree Chopper break once their timer runs out',
      'Many more small utilities bundled in',
    ],
    tech: ['Java', 'Fabric', 'Mixin'],
    note: 'Always building, always ready for the next challenge.',
  },
];
---

<Base>
  <nav>
    <div class="container">
      <a href="/" class="logo">veekshith<span>.</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#about">About</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#archived">Archived</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <!-- ─── Hero ─── -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-tag">open for work</div>
        <h1>
          I make stuff<br />
          <span class="highlight">for game servers</span><br />
          <span class="fade">and the people on em</span>
        </h1>
        <p>
          Minecraft plugins, Discord bots, web dashboards — if it runs a gaming community, 
          I've probably built something like it. Been at this for a few years now.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">See my work</a>
          <a href="#contact" class="btn btn-secondary">Hit me up</a>
        </div>
      </div>
    </section>

    <hr />

    <!-- ─── Stats ─── -->
    <section class="section reveal">
      <div class="stats-ribbon">
        <div class="stat-item">
          <span class="stat-number">3+</span>
          <span class="stat-label">Years Building</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">6+</span>
          <span class="stat-label">Projects Delivered</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">50+</span>
          <span class="stat-label">Features Shipped</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">Full</span>
          <span class="stat-label">Stack Development</span>
        </div>
      </div>
    </section>

    <hr />

    <!-- ─── About ─── -->
    <section id="about" class="section reveal">
      <div class="section-header">
        <div class="section-label">About</div>
        <h2 class="section-title">What I do</h2>
      </div>
      <div class="about-text">
        <p>
          I build <strong>Minecraft plugins</strong> and <strong>Discord bots</strong>
          for SMP servers. Java + Spigot/Paper on the plugin side, TypeScript + 
          Discord.js for bots, and SQLite when I need stuff to persist.
        </p>
        <p>
          Lead dev at <strong>Apex SMP</strong> — building and managing the custom plugins
          that run the server — plus Discord dev work over at <strong>Papaya SMP</strong>
          where I made their ticket bot. Also run <strong>ShapeSMP</strong>, a private SMP
          where I handle all the management and custom plugins. Built the
          <strong>Apex Building Bot</strong> for ticketing, moderation and giveaways, and
          made <strong>Minecraft Skin Gallery</strong>, a 3D skin viewer that works for any
          username you throw at it.
        </p>
        <p>
          Right now I'm deep in <strong>Vanilla-Core</strong>, an SMP plugin that's 
          live but still got bugs I'm squashing. Every project I ship comes with 
          readable code and a readme that actually tells you what's what.
        </p>
      </div>
    </section>

    <hr />

    <!-- ─── Experience ─── -->
    <section id="experience" class="section reveal">
      <div class="section-header">
        <div class="section-label">Experience</div>
        <h2 class="section-title">Where I've worked</h2>
      </div>
      <div class="experience-list">
        <div class="experience-card">
          <div class="exp-header">
            <div class="exp-head-main">
              <img src="https://cdn.discordapp.com/icons/1521151546904285385/eaee9a7f2f06b334f74d59ba1d1a0aa4.png" alt="Apex SMP" class="exp-guild-icon" width="44" height="44" loading="lazy" />
              <div>
                <h3 class="exp-title">Lead Developer</h3>
                <p class="exp-org">Apex SMP</p>
              </div>
            </div>
            <span class="exp-period">2025 — Present</span>
          </div>
          <div class="exp-details">
            <p>
              Lead dev for the server — building and maintaining the custom plugins that
              run the whole SMP, and managing the dev side of the community. Anything that
              needs to be coded, I build and ship it.
            </p>
          </div>
          <div class="exp-links">
            <a href="https://discord.gg/MvwdNzwcxX" target="_blank" rel="noopener noreferrer" class="exp-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              discord.gg/MvwdNzwcxX
            </a>
          </div>
        </div>

        <div class="experience-card">
          <div class="exp-header">
            <div class="exp-head-main">
              <img src="https://cdn.discordapp.com/icons/1266459225316655275/b99a2ed23e3475abe0d64a63d18f0274.png" alt="Papaya SMP" class="exp-guild-icon" width="44" height="44" loading="lazy" />
              <div>
                <h3 class="exp-title">Discord Developer</h3>
                <p class="exp-org">Papaya SMP</p>
              </div>
            </div>
            <span class="exp-period">2025 — Present</span>
          </div>
          <div class="exp-details">
            <p>
              Built the server's ticket bot from the ground up to handle support and staff
              workflows, and keep the community tooling running smoothly as a Discord dev.
            </p>
          </div>
          <div class="exp-links">
            <a href="https://discord.gg/8FDwDXbMmm" target="_blank" rel="noopener noreferrer" class="exp-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              discord.gg/8FDwDXbMmm
            </a>
          </div>
        </div>

        <div class="experience-card">
          <div class="exp-header">
            <div class="exp-head-main">
              <img src="https://cdn.discordapp.com/icons/1521258381200068718/4daa5bf8c9baf8dd9cfcd5a10ae337f7.png" alt="Shape SMP" class="exp-guild-icon" width="44" height="44" loading="lazy" />
              <div>
                <h3 class="exp-title">Developer &amp; Manager</h3>
                <p class="exp-org">ShapeSMP</p>
              </div>
            </div>
            <span class="exp-period">2025 — Present</span>
          </div>
          <div class="exp-details">
            <p>
              Private SMP where I handle all of the management and build custom plugins
              whenever something is needed. End-to-end ownership of the server backend and
              tooling.
            </p>
          </div>
          <div class="exp-links">
            <a href="https://discord.gg/gXbPPdSUEJ" target="_blank" rel="noopener noreferrer" class="exp-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              discord.gg/gXbPPdSUEJ
            </a>
          </div>
        </div>

        <div class="experience-card">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Admin / Developer</h3>
              <p class="exp-org">Vanilla SMP</p>
            </div>
            <span class="exp-period">2025 — Present</span>
          </div>
          <div class="exp-details">
            <p>
              Ran the server backend, built custom plugins for the survival experience,
              and kept things running on the admin side. Handled everything from plugin
              configs to player reports to making sure the server didn't lag itself
              to death when folks started building crazy farms.
            </p>
          </div>
        </div>

        <div class="experience-card">
          <div class="exp-header">
            <div>
              <h3 class="exp-title">Developer</h3>
              <p class="exp-org">Allay SMP / Blossom SMP</p>
            </div>
            <span class="exp-period">2025 — Present</span>
          </div>
          <div class="exp-details">
            <p>
              Came up through these servers building Discord bots and learning the ropes
              of Minecraft plugin dev. Made moderation bots, ticket systems, and a bunch
              of small plugins that taught me how to actually ship stuff that people use.
              Both servers are where I cut my teeth before moving on to bigger projects.
            </p>
          </div>
        </div>
      </div>
    </section>

    <hr />

    <!-- ─── Skills ─── -->
    <section id="skills" class="section reveal">
      <div class="section-header">
        <div class="section-label">Skills</div>
        <h2 class="section-title">Technical stack</h2>
      </div>
      <div class="skills-grid reveal-stagger">
        {skills.map((sk) => (
           <div class="skill-card">
            <div class="skill-card-header">
              <div class="skill-card-icon">
                {sk.logo ? (
                  <img src={sk.logo} alt={sk.title} class="skill-logo" width="18" height="18" loading="lazy" />
                ) : (
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                )}
              </div>
              <h3>{sk.title}</h3>
            </div>
            <p>{sk.desc}</p>
            <div class="skill-tags">
              {sk.tags.map((t) => <span class="skill-tag">{t}</span>)}
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr />

    <!-- ─── Projects ─── -->
    <section id="projects" class="section reveal">
      <div class="section-header">
        <div class="section-label">Projects</div>
        <h2 class="section-title">What I've built</h2>
        <p class="section-subtitle">Plugins, bots, and web apps — the stuff I've shipped.</p>
      </div>
      <div class="project-grid reveal-stagger">
        {projects.map((p) => (
          <article class={`project-card${p.status === 'alpha' ? ' featured' : ''}`}>
            {p.badges && (
              <div class="project-badges">
                {p.badges.map((b) => (
                  <span class={`project-badge ${b}`}>
                    {b === 'released' ? '● Released' : b === 'alpha' ? '⚠ Early Alpha — Active Debugging' : ''}
                  </span>
                ))}
              </div>
            )}
            <div class="project-body">
              <div class="project-head">
                <h3 class="project-name">{p.name}</h3>
                <span class="project-type">{p.type}</span>
              </div>
              <p class="project-desc">{p.desc}</p>
              <ul class="project-features">
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <div class="project-tech">
                {p.tech.map((t) => <span class="project-tech-tag">{t}</span>)}
              </div>
              <div class="project-links">
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="project-link">
                  <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                  Source
                </a>
                {p.live && (
                  <a href={p.live} target="_blank" rel="noopener noreferrer" class="project-link">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    Live
                  </a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <hr />

    <!-- ─── Archived / Lost ─── -->
    <section id="archived" class="section reveal">
      <div class="section-header">
        <div class="section-label">Archived</div>
        <h2 class="section-title">Lost &amp; deprecated</h2>
        <p class="section-subtitle">Old builds where the source drifted away — but the ideas stuck.</p>
      </div>
      <div class="project-grid reveal-stagger">
        {archived.map((p) => (
          <article class="project-card lost">
            <div class="project-badges">
              <span class="project-badge building">△ Lost Files</span>
            </div>
            <div class="project-body">
              <div class="project-head">
                <div class="project-head-title">
                  <img src={fabricLogo} alt="Fabric" class="project-logo" width="22" height="22" loading="lazy" />
                  <h3 class="project-name">{p.name}</h3>
                </div>
                <span class="project-type">{p.type}</span>
              </div>
              <p class="project-desc">{p.desc}</p>
              <ul class="project-features">
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <div class="project-tech">
                {p.tech.map((t) => <span class="project-tech-tag">{t}</span>)}
              </div>
              {p.note && <p class="project-note">{p.note}</p>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <hr />

    <!-- ─── Contact ─── -->
    <section id="contact" class="contact-section">
      <div class="contact-inner">
        <h2>Wanna build something?</h2>
        <p>Got a server that needs plugins, a Discord that needs a bot, or just wanna chat? Hit me up.</p>
        <div class="contact-links">
          <a href="mailto:veekshith177@gmail.com" class="contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            Email
          </a>
          <a href="https://github.com/veekshith177-bot" target="_blank" class="contact-link">
            <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
          <a href="https://discord.com/users/1322117319060619307" target="_blank" rel="noopener noreferrer" class="contact-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            DM me
          </a>
        </div>
      </div>
    </section>

    <!-- ─── Footer ─── -->
    <footer>
      <p><span class="accent">veekshith</span> &copy; 2026 &nbsp;·&nbsp; built with astro</p>
    </footer>
  </div>
</Base>
