---
import Base from '../layouts/Base.astro';

const skills = [
  {
    title: 'Discord.js Ecosystems',
    desc: 'Building resilient, shard-ready bots that scale across thousands of guilds. Custom dashboards, interaction handling, and caching strategies.',
    tags: ['TypeScript', 'Redis', 'Sharding'],
    icon: 'smart_toy',
    color: 'purple',
    span: 'large',
  },
  {
    title: 'Java & Spigot API',
    desc: 'Custom game modes, economy systems, and performance-optimized plugins for heavy-load Minecraft networks.',
    tags: ['Java', 'Spigot', 'PaperMC', 'Bukkit API'],
    icon: 'code_blocks',
    color: 'cyan',
    span: 'wide',
  },
  {
    title: 'SQLite / DBs',
    desc: 'Lightweight data layers with simple schemas, validation, and clear fallback behavior.',
    tags: ['SQLite', 'Supabase', 'REST APIs'],
    icon: 'database',
    color: 'orange',
    span: 'small',
  },
  {
    title: 'Docker & CI/CD',
    desc: 'Containerized deployments and automated pipelines for reliable, reproducible builds.',
    tags: ['Docker', 'GitHub Actions', 'Linux'],
    icon: 'build_circle',
    color: 'purple',
    span: 'small',
  },
];

const projects = [
  {
    name: 'Apex Building Bot',
    type: 'Discord Bot',
    desc: 'Full-service Discord bot for Donut SMP and Apex communities. Ticketing, moderation, giveaways, LOA tracking, builder applications, and more — all backed by SQLite with WAL mode.',
    features: [
      'Ticket panels: General, Build, Digout, Refund, Regear + more',
      'Moderation: warn, mute, tempban, slowmode, lock/unlock',
      'Split or Steal giveaway system with daily auto-giveaways',
      'Builder application forms with cooldown window',
      'DM-based builder rating and feedback system',
    ],
    tech: ['TypeScript', 'Node.js', 'Discord.js v14', 'better-sqlite3'],
    github: 'https://github.com/veekshith177-bot/Apex-Building-Bot',
    live: 'https://discord.gg/n7qY76PMH7',
    color: 'purple',
  },
  {
    name: 'Apex Bot Dashboard',
    type: 'Web App',
    desc: 'Web dashboard companion for the Apex Building Bot — view command stats, server analytics, moderation logs, and manage your Discord server visually in real time.',
    features: [
      'Real-time command usage metrics and graphs',
      'Server activity and member analytics',
      'Moderation log viewer with search',
      'Role and permission management UI',
      'Direct integration with Apex Building Bot',
    ],
    tech: ['Astro', 'React', 'Discord API', 'Chart.js', 'SQLite'],
    github: 'https://github.com/veekshith177-bot/Apex-Building-Bot',
    live: '#',
    color: 'orange',
  },
  {
    name: 'Minecraft Skin Gallery',
    type: 'Web App',
    desc: '3D Minecraft skin viewer. Type any username and see their skin rendered in real-time with 6 animations, cape support, auto model detection, and a full Minecraft-themed UI.',
    features: [
      'Real-time 3D rendering with skinview3d + Three.js',
      '6 animations: Walk, Run, Fly, Wave, Crouch, Swim',
      'Auto-detects Alex vs Steve arm models',
      'Cape support for any player who has one',
      'Responsive across desktop, tablet, and mobile',
    ],
    tech: ['Astro', 'Three.js', 'skinview3d', 'PlayerDB API'],
    github: 'https://github.com/veekshith177-bot/Minecraft-Skin-Gallery',
    live: 'https://minecraft-skin-gallery.netlify.app',
    color: 'cyan',
  },
];

const services = [
  {
    title: 'Minecraft Plugin Builds',
    desc: 'Custom command packs, SMP utilities, staff tools, and small persistence layers for Spigot or Paper servers.',
    points: ['Commands', 'Permissions', 'SQLite', 'Config'],
  },
  {
    title: 'Discord Bot Features',
    desc: 'Slash commands, ticket flows, giveaway logic, role checks, logging, and service automation for any community.',
    points: ['Discord.js', 'Buttons', 'Modals', 'Logs'],
  },
  {
    title: 'Backend & Tooling',
    desc: 'Route handlers, data validation, storage fallbacks, and lightweight web UIs for community-facing tools.',
    points: ['Next.js', 'APIs', 'Supabase', 'Validation'],
  },
];
---

<Base>
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="scanline"></div>

  <nav>
    <div class="container">
      <a href="#" class="logo">veekshith</a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="#skills">Stack</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="/building">Building</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <!-- ─── Hero ─── -->
    <section class="hero">
      <div class="hero-content">
        <div class="hero-badge">open for freelance builds</div>
        <h1>
          I build server tools that make<br />
          <span class="hl-gradient">communities run smoother</span>
        </h1>
        <p>Specialized in backend architecture, discord integrations, and game server tooling.</p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">View Projects</a>
          <a href="https://discord.gg/2fakAhQpP8" target="_blank" class="btn btn-secondary">Join Discord</a>
        </div>
      </div>
    </section>

    <hr />

    <!-- ─── Stats ─── -->
    <section class="section reveal">
      <div class="stats-ribbon glass-panel">
        <div class="stat-item">
          <span class="material-symbols-outlined stat-icon">terminal</span>
          <p class="stat-label">3+ Years Experience</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="material-symbols-outlined stat-icon">dns</span>
          <p class="stat-label">6+ Builds Delivered</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="material-symbols-outlined stat-icon">commit</span>
          <p class="stat-label">50+ Features Shipped</p>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="material-symbols-outlined stat-icon">layers</span>
          <p class="stat-label">Full-Stack Focus</p>
        </div>
      </div>
    </section>

    <hr />

    <!-- ─── About ─── -->
    <section class="section reveal">
      <div class="section-head">
        <div class="section-label">About</div>
        <h2 class="section-title">What I do</h2>
      </div>
      <div class="about-text" style="max-width:680px">
        <p style="font-size:16px;color:var(--obs-on-surface-variant);margin-bottom:16px;line-height:1.8">
          I build <strong style="color:var(--obs-secondary)">Minecraft plugins</strong> and <strong style="color:var(--obs-secondary)">Discord bots</strong>
          for SMP servers and gaming communities. My stack is Java + Spigot/Paper on
          the plugin side, TypeScript + Discord.js for bots, and SQLite or Supabase
          when I need persistence.
        </p>
        <p style="font-size:16px;color:var(--obs-on-surface-variant);margin-bottom:16px;line-height:1.8">
          I built the <strong style="color:var(--obs-secondary)">Apex Building Bot</strong> — a full-service Discord bot
          with ticketing, moderation, giveaways, and application flows — plus its
          <strong style="color:var(--obs-secondary)">web dashboard</strong> for real-time server analytics and management.
          I also built <strong style="color:var(--obs-secondary)">Minecraft Skin Gallery</strong>, a 3D skin viewer that
          renders any player's skin in real-time. Every project gets readable code,
          scoped feature lists, and clear handoff notes.
        </p>
      </div>
    </section>

    <hr />

    <!-- ─── Skills / Bento ─── -->
    <section id="skills" class="section reveal">
      <div class="section-head">
        <div class="section-label">Skills</div>
        <h2 class="section-title">Technical stack</h2>
      </div>
      <div class="bento-grid reveal-stagger">
        {skills.map((sk) => {
          const hoverClass = sk.color === 'purple' ? 'bento-hover-purple' : sk.color === 'cyan' ? 'bento-hover-cyan' : 'bento-hover-orange';
          const spanCols = sk.span === 'large' ? 6 : sk.span === 'wide' ? 6 : 3;
          const spanRows = sk.span === 'large' ? 2 : 1;
          const isSmall = sk.span === 'small';
          return (
            <div class={`bento-card glass-panel ${hoverClass}`} style={`grid-column:span ${spanCols};grid-row:span ${spanRows};${isSmall ? 'align-items:center;justify-content:center;text-align:center' : ''}`}>
              {!isSmall && <div class="bento-bg-glow"></div>}
              <div class="bento-content">
                {!isSmall && (
                  <div class="bento-icon-box">
                    <span class="material-symbols-outlined bento-icon" style={`color:${sk.color === 'purple' ? 'var(--obs-primary)' : sk.color === 'cyan' ? 'var(--obs-secondary)' : 'var(--obs-tertiary)'}`}>{sk.icon}</span>
                  </div>
                )}
                {isSmall && (
                  <span class="material-symbols-outlined" style={`font-size:32px;color:${sk.color === 'purple' ? 'var(--obs-primary)' : sk.color === 'cyan' ? 'var(--obs-secondary)' : 'var(--obs-tertiary)'};margin-bottom:12px`}>{sk.icon}</span>
                )}
                <h3 class="bento-title" style={`font-size:${isSmall ? '24px' : '32px'};${isSmall ? 'margin:0' : ''}`}>{sk.title}</h3>
                {!isSmall && <p class="bento-desc">{sk.desc}</p>}
              </div>
              {!isSmall && (
                <div class="bento-tags">
                  {sk.tags.map((t) => <span class="bento-tag">{t}</span>)}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>

    <hr />

    <!-- ─── Projects ─── -->
    <section id="projects" class="section reveal">
      <div class="section-head">
        <div class="section-label">Projects</div>
        <h2 class="section-title">Deployed architecture</h2>
      </div>
      <div class="project-grid reveal-stagger">
        {projects.map((p) => {
          const hoverClass = p.color === 'purple' ? 'bento-hover-purple' : p.color === 'cyan' ? 'bento-hover-cyan' : 'bento-hover-orange';
          const fileName = p.name.toLowerCase().replace(/\s+/g, '_').replace(/[^a-z_]/g, '') + (p.type === 'Discord Bot' ? '.ts' : p.type === 'Web App' ? '.js' : '.jar');
          return (
            <article class={`project-card glass-panel ${hoverClass}`}>
              <div class="project-macos-header">
                <div class="project-macos-dots">
                  <span class="project-macos-dot red"></span>
                  <span class="project-macos-dot yellow"></span>
                  <span class="project-macos-dot green"></span>
                </div>
                <span class="project-macos-title">{fileName}</span>
                <div style="width:48px"></div>
              </div>
              <div class="project-card-image" style="margin:0 24px 24px">
                {p.name === 'Minecraft Skin Gallery' ? (
                  <span class="material-symbols-outlined" style="font-size:64px;color:rgba(0,218,243,0.5)">view_in_ar</span>
                ) : (
                  <span class="material-symbols-outlined" style={`font-size:64px;color:${p.color === 'purple' ? 'rgba(220,184,255,0.4)' : 'rgba(255,184,115,0.4)'}`}>deployed_code</span>
                )}
              </div>
              <div class="project-card-body">
                <div class="project-head">
                  <h3 class="project-name">{p.name}</h3>
                  <span class="project-type">{p.type}</span>
                </div>
                <p class="project-desc">{p.desc}</p>
                <ul class="project-features">
                  {p.features.map((f) => <li>{f}</li>)}
                </ul>
                <div class="project-tech">
                  {p.tech.map((t) => <span class="project-tech-tag">{t}</span>)}
                </div>
                <div class="project-links">
                  <a href={p.github} target="_blank" rel="noopener noreferrer" class="project-link">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
                    {p.github !== '#' ? 'Source' : 'Private'}
                  </a>
                  <a href={p.live} target="_blank" rel="noopener noreferrer" class="project-link">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    {p.live !== '#' ? 'Live' : 'Private'}
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <div style="text-align:center;margin-top:40px">
        <a href="/building" class="btn btn-secondary" style="font-family:'JetBrains Mono',monospace">
          △ view projects in progress →
        </a>
      </div>
    </section>

    <hr />

    <!-- ─── Services ─── -->
    <section id="services" class="section reveal">
      <div class="section-head">
        <div class="section-label">Services</div>
        <h2 class="section-title">What I can build for you</h2>
      </div>
      <div class="bento-grid reveal-stagger">
        {services.map((svc, i) => {
          const colors = ['purple', 'cyan', 'orange'];
          const icons = ['terminal', 'smart_toy', 'build_circle'];
          const color = colors[i];
          const hoverClass = color === 'purple' ? 'bento-hover-purple' : color === 'cyan' ? 'bento-hover-cyan' : 'bento-hover-orange';
          return (
            <div class={`bento-card glass-panel ${hoverClass}`} style="grid-column:span 4;grid-row:span 1">
              <div class="bento-bg-glow"></div>
              <div class="bento-content">
                <div class="bento-icon-box">
                  <span class="material-symbols-outlined bento-icon" style={`color:${color === 'purple' ? 'var(--obs-primary)' : color === 'cyan' ? 'var(--obs-secondary)' : 'var(--obs-tertiary)'}`}>{icons[i]}</span>
                </div>
                <h3 class="bento-title" style="font-size:24px">{svc.title}</h3>
                <p class="bento-desc">{svc.desc}</p>
              </div>
              <div class="bento-tags">
                {svc.points.map((pt) => <span class="bento-tag">{pt}</span>)}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <hr />

    <!-- ─── Contact ─── -->
    <section id="contact" class="contact-section">
      <div class="contact-inner">
        <h2>Let's build something</h2>
        <p>Got a server that needs custom tools or a community that deserves better automation? Reach out.</p>
        <div class="contact-links">
          <a href="mailto:veekshith177@gmail.com" class="contact-link">Email</a>
          <a href="https://github.com/veekshith177-bot" target="_blank" class="contact-link">GitHub</a>
          <a href="https://discord.gg/2fakAhQpP8" target="_blank" class="contact-link">Discord</a>
        </div>
      </div>
    </section>

    <!-- ─── Footer ─── -->
    <footer>
      <p><span class="accent">veekshith</span> &copy; 2026 &nbsp;·&nbsp; built with astro</p>
    </footer>
  </div>
</Base>
