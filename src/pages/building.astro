---
import Base from '../layouts/Base.astro';

const building = [
  {
    name: 'Server Status Monitor',
    type: 'Web App',
    desc: 'Public status page that pings your services every 5 minutes and shows live indicators with incident history.',
    features: [
      'Automated uptime checks every 5 min',
      'Live status indicators',
      'Incident timeline with history',
      'Slack/Discord alert webhooks',
    ],
    tech: ['Astro', 'GitHub Actions', 'Upptime'],
  },
  {
    name: 'Minecraft Recipe Finder',
    type: 'Web App',
    desc: 'Searchable recipe book — look up crafting and smelting recipes by item, ingredient, or category.',
    features: [
      'Search by item name or ingredient',
      'Filter by crafting, smelting, or both',
      'Visual crafting grid display',
      'Mobile-friendly layout',
    ],
    tech: ['Astro', 'Vanilla JS', 'Minecraft Data'],
  },
];
---

<Base>
  <nav>
    <div class="container">
      <a href="/" class="logo">veekshith<span>.</span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <ul class="nav-links" id="navLinks">
        <li><a href="/">Home</a></li>
      </ul>
    </div>
  </nav>

  <div class="container" style="padding-top:120px">
    <section class="section">
      <div class="section-header">
        <div class="section-label">In Progress</div>
        <h1 class="section-title">
          Projects <span style="color:var(--text-secondary)">in development</span>
        </h1>
        <p class="section-subtitle">Shipping soon. Each one gets readable code, scoped features, and clear docs.</p>
      </div>

      <div class="project-grid reveal-stagger">
        {building.map((p) => (
          <article class="project-card">
            <div class="project-badges">
              <span class="project-badge building">△ Building</span>
            </div>
            <div class="project-body">
              <div class="project-head">
                <h3 class="project-name">{p.name}</h3>
                <span class="project-type">{p.type}</span>
              </div>
              <p class="project-desc">{p.desc}</p>
              <ul class="project-features">
                {p.features.map((f) => <li>{f}</li>)}
              </ul>
              <div class="project-tech">
                {p.tech.map((t) => <span class="project-tech-tag">{t}</span>)}
              </div>
              <div class="project-links">
                <span class="project-link" style="opacity:0.4;cursor:default">Coming soon</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div style="text-align:center;margin-top:48px">
        <a href="/" class="btn btn-secondary">← Back to projects</a>
      </div>
    </section>

    <footer>
      <p><span class="accent">veekshith</span> &copy; 2026 &nbsp;·&nbsp; built with astro</p>
    </footer>
  </div>
</Base>
