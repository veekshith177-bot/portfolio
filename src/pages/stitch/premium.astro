---
import Obsidian from '../../layouts/Obsidian.astro';
---

<Obsidian title="Premium Backend Portfolio with 3D Motion">
  <nav class="obs-nav">
    <div class="obs-nav-inner">
      <a href="/" class="obs-nav-logo">BACKEND_ARCHITECT</a>
      <div class="obs-nav-links">
        <a href="#" class="active">PROJECTS</a>
        <a href="#">STACK</a>
        <a href="#">ARCHITECTURE</a>
        <a href="#">LOGS</a>
      </div>
      <div class="obs-nav-status">
        <span class="obs-nav-status-dot animate-pulse-glow"></span>
        SYSTEM STATUS: ONLINE
      </div>
    </div>
  </nav>

  <main class="obs-main">
    <section class="obs-hero">
      <div class="obs-hero-text">
        <h1 class="obs-hero-title">
          I build server tools that make <br class="hide-mob" />
          <span class="text-gradient">communities run smoother</span>
        </h1>
        <p class="obs-hero-sub">
          &gt; Specialized in high-performance backend architecture, discord integrations, and robust game server orchestration.
        </p>
        <div style="margin-top:32px">
          <a href="#" class="terminal-btn">
            <span class="terminal-btn-prefix">&gt;</span>
            initiate_contact --now
            <span class="terminal-btn-cursor"></span>
          </a>
        </div>
      </div>
      <div class="obs-hero-3d tilt-container">
        <div class="obs-hero-3d-inner glass-panel bento-hover-cyan tilt-element" id="hero3dScene">
          <div style="position:absolute;inset:0;opacity:0.2;background:radial-gradient(circle at center, var(--obs-primary), var(--obs-surface), var(--obs-background));pointer-events:none;z-index:0"></div>
          <div class="obs-hero-3d-badge">
            <span class="material-symbols-outlined" style="font-size:14px">view_in_ar</span>
            MOUSE_INTERACT
          </div>
        </div>
      </div>
    </section>

    <section class="stats-ribbon glass-panel">
      <div class="stat-item">
        <span class="material-symbols-outlined stat-icon">terminal</span>
        <p class="stat-label">3+ Years Experience</p>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="material-symbols-outlined stat-icon">dns</span>
        <p class="stat-label">6+ Builds Delivered</p>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="material-symbols-outlined stat-icon">commit</span>
        <p class="stat-label">50+ Features Shipped</p>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="material-symbols-outlined stat-icon">layers</span>
        <p class="stat-label">Full-Stack Focus</p>
      </div>
    </section>

    <section class="obs-section">
      <div class="obs-section-header">
        <h2 class="obs-section-title">TECHNICAL_STACK</h2>
      </div>
      <div class="bento-grid">
        <div class="bento-card glass-panel bento-hover-purple" style="grid-column:span 6;grid-row:span 2">
          <div class="bento-bg-glow"></div>
          <div class="bento-content">
            <div class="bento-icon-box">
              <span class="material-symbols-outlined bento-icon" style="color:var(--obs-primary)">smart_toy</span>
            </div>
            <h3 class="bento-title" style="font-size:32px">Discord.js Ecosystems</h3>
            <p class="bento-desc">Building resilient, shard-ready bots that scale across thousands of guilds. Custom dashboards, interaction handling, and caching strategies.</p>
          </div>
          <div class="bento-tags">
            <span class="bento-tag">TypeScript</span>
            <span class="bento-tag">Redis</span>
            <span class="bento-tag">Sharding</span>
          </div>
        </div>
        <div class="bento-card glass-panel bento-hover-cyan" style="grid-column:span 6;grid-row:span 1">
          <div class="bento-content" style="justify-content:center">
            <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px">
              <span class="material-symbols-outlined" style="font-size:24px;color:var(--obs-secondary)">code_blocks</span>
              <h3 class="bento-title" style="font-size:24px;margin:0">Java &amp; Spigot API</h3>
            </div>
            <p class="bento-desc">Custom game modes, economy systems, and performance-optimized plugins for heavy-load Minecraft networks.</p>
          </div>
        </div>
        <div class="bento-card glass-panel bento-hover-orange" style="grid-column:span 3;grid-row:span 1;align-items:center;justify-content:center;text-align:center">
          <span class="material-symbols-outlined" style="font-size:32px;color:var(--obs-tertiary);margin-bottom:12px">database</span>
          <h3 class="bento-title" style="font-size:24px;margin:0;text-align:center">SQLite / DBs</h3>
        </div>
        <div class="bento-card glass-panel bento-hover-purple" style="grid-column:span 3;grid-row:span 1;align-items:center;justify-content:center;text-align:center">
          <span class="material-symbols-outlined" style="font-size:32px;color:var(--obs-primary);margin-bottom:12px">build_circle</span>
          <h3 class="bento-title" style="font-size:24px;margin:0;text-align:center">Docker &amp; CI/CD</h3>
        </div>
      </div>
    </section>

    <section class="obs-section">
      <div class="obs-section-header">
        <h2 class="obs-section-title">DEPLOYED_ARCHITECTURE</h2>
        <a href="#" class="obs-section-link">
          view_all <span class="material-symbols-outlined" style="font-size:16px">arrow_forward</span>
        </a>
      </div>
      <div class="project-grid">
        <div class="project-card glass-panel bento-hover-purple">
          <div class="macos-header">
            <div class="macos-dots">
              <span class="macos-dot red"></span>
              <span class="macos-dot yellow"></span>
              <span class="macos-dot green"></span>
            </div>
            <span style="flex:1;text-align:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">apex_bot.ts</span>
            <div style="width:48px"></div>
          </div>
          <div class="project-card-image">
            <img src="/screenshots/screen2.png" alt="Apex Bot Dashboard" />
          </div>
          <div class="project-card-body">
            <h3 class="project-card-title">Apex Building Bot</h3>
            <p class="project-card-desc">A comprehensive Discord utility bot managing support tickets, auto-moderation, and application pipelines for a 10k+ member community.</p>
            <div class="project-card-tags">
              <span class="project-tag" style="color:var(--obs-primary)">TypeScript</span>
              <span class="project-tag" style="color:var(--obs-secondary)">Discord.js</span>
            </div>
          </div>
        </div>
        <div class="project-card glass-panel bento-hover-orange">
          <div class="macos-header">
            <div class="macos-dots">
              <span class="macos-dot red"></span>
              <span class="macos-dot yellow"></span>
              <span class="macos-dot green"></span>
            </div>
            <span style="flex:1;text-align:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">phantom_core.jar</span>
            <div style="width:48px"></div>
          </div>
          <div class="project-card-image">
            <span class="material-symbols-outlined" style="font-size:64px;color:rgba(255,184,115,0.5)">deployed_code</span>
          </div>
          <div class="project-card-body">
            <h3 class="project-card-title">Phantom Larpz Core</h3>
            <p class="project-card-desc">Custom backend core for a roleplay server featuring advanced inventory management, dynamic territory control, and real-time database syncing.</p>
            <div class="project-card-tags">
              <span class="project-tag" style="color:var(--obs-tertiary)">Java</span>
              <span class="project-tag" style="color:var(--obs-on-surface)">MySQL</span>
            </div>
          </div>
        </div>
        <div class="project-card glass-panel bento-hover-cyan">
          <div class="macos-header">
            <div class="macos-dots">
              <span class="macos-dot red"></span>
              <span class="macos-dot yellow"></span>
              <span class="macos-dot green"></span>
            </div>
            <span style="flex:1;text-align:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">skin_preview.js</span>
            <div style="width:48px"></div>
          </div>
          <div class="project-card-image" id="skinGalleryCanvas">
          </div>
          <div class="project-card-body">
            <h3 class="project-card-title">Minecraft Skin Gallery</h3>
            <p class="project-card-desc">Interactive 3D previewer for player cosmetics, integrating directly with custom game server APIs to render active loadouts.</p>
            <div class="project-card-tags">
              <span class="project-tag" style="color:var(--obs-secondary)">Three.js</span>
              <span class="project-tag" style="color:var(--obs-on-surface)">WebGL</span>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="obs-footer">
    <div class="obs-footer-inner">
      <div class="obs-footer-cta glass-panel bento-hover-purple">
        <span class="material-symbols-outlined obs-footer-cta-icon">rocket_launch</span>
        <h2 class="obs-footer-cta-title">Ready to upgrade your infrastructure?</h2>
        <div class="obs-footer-terminal">
          <div class="obs-footer-terminal-bar"></div>
          <span class="prompt-primary">~</span> <span class="prompt-secondary">ssh</span> contact@veekshith.dev
          <span class="terminal-cursor" style="display:inline-block;width:8px;height:16px;background:var(--obs-on-surface);vertical-align:middle;margin-left:4px"></span>
        </div>
      </div>
      <div class="obs-footer-links">
        <a href="#" class="obs-footer-link">EMAIL</a>
        <a href="#" class="obs-footer-link">GITHUB</a>
        <a href="#" class="obs-footer-link">DISCORD</a>
      </div>
      <div class="obs-footer-copy">VEEKSHITH &copy; 2026 &bull; BUILT WITH ASTRO</div>
      <div class="obs-footer-small">&copy; 2024 ROOT_ACCESS. ALL RIGHTS RESERVED.</div>
    </div>
  </footer>

  <script>
    import { initHeroScene, initSkinGallery } from '../../scripts/stitch-three';

    const heroContainer = document.getElementById('hero3dScene');
    const skinContainer = document.getElementById('skinGalleryCanvas');

    let heroScene = null;
    let skinScene = null;

    if (heroContainer && window.innerWidth > 768) {
      heroScene = initHeroScene(heroContainer);
    }
    if (skinContainer && window.innerWidth > 768) {
      skinScene = initSkinGallery(skinContainer);
    }

    window.addEventListener('beforeunload', () => {
      if (heroScene) heroScene.destroy();
      if (skinScene) skinScene.destroy();
    });

    const tiltContainer = document.querySelector('.tilt-container');
    const tiltElement = document.getElementById('hero3dScene');
    if (tiltContainer && tiltElement) {
      tiltContainer.addEventListener('mousemove', function(e) {
        const rect = tiltContainer.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;
        tiltElement.style.transform = 'rotateX(' + rotateX + 'deg) rotateY(' + rotateY + 'deg) scale3d(1.02, 1.02, 1.02)';
      });
      tiltContainer.addEventListener('mouseleave', function() {
        tiltElement.style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
      });
    }
  </script>
</Obsidian>
