---
import Obsidian from '../../layouts/Obsidian.astro';
---

<Obsidian title="Obsidian Terminal — Design System">
  <style>
    .ds-page {
      padding-top: 100px;
      padding-bottom: 80px;
      max-width: 1200px;
      margin: 0 auto;
      width: 100%;
      padding-left: 80px;
      padding-right: 80px;
      position: relative;
      z-index: 1;
    }

    @media (max-width: 1024px) {
      .ds-page { padding-left: 20px; padding-right: 20px; }
    }

    .ds-hero {
      margin-bottom: 80px;
    }

    .ds-hero h1 {
      font-size: 64px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.04em;
      color: var(--obs-on-surface);
      margin: 0 0 8px;
    }

    .ds-hero p {
      font-family: 'JetBrains Mono', monospace;
      color: var(--obs-on-surface-variant);
      margin: 0;
    }

    .ds-section {
      margin-bottom: 64px;
    }

    .ds-section h2 {
      font-size: 32px;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--obs-on-surface);
      margin: 0 0 24px;
    }

    .ds-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 12px;
    }

    .ds-swatch {
      border-radius: 8px;
      padding: 20px 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      position: relative;
      min-height: 80px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      border: 1px solid rgba(255,255,255,0.06);
    }

    .ds-swatch-name {
      font-weight: 600;
      margin-bottom: 2px;
    }

    .ds-swatch-hex {
      opacity: 0.7;
      font-size: 10px;
    }

    .ds-type-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }

    .ds-type-card {
      padding: 24px;
      border-radius: 12px;
    }

    .ds-type-card .token-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: var(--obs-on-surface-variant);
      margin-bottom: 8px;
    }

    .ds-type-sample {
      margin: 0;
    }

    .ds-spacing-grid {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .ds-spacing-row {
      display: flex;
      align-items: center;
      gap: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--obs-on-surface-variant);
    }

    .ds-spacing-bar {
      height: 16px;
      background: var(--obs-primary);
      border-radius: 4px;
      opacity: 0.6;
      flex-shrink: 0;
    }

    .ds-component-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }

    .ds-comp-demo {
      padding: 32px;
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }

    .ds-comp-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--obs-on-surface-variant);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
  </style>

  <nav class="obs-nav">
    <div class="obs-nav-inner">
      <a href="/" class="obs-nav-logo">OBSIDIAN_DS</a>
      <div class="obs-nav-links">
        <a href="#colors" class="active">COLORS</a>
        <a href="#typography">TYPOGRAPHY</a>
        <a href="#spacing">SPACING</a>
        <a href="#components">COMPONENTS</a>
      </div>
    </div>
  </nav>

  <div class="ds-page">
    <div class="ds-hero">
      <h1>Obsidian Terminal</h1>
      <p>Design system for a high-end backend developer portfolio. Dark mode, glassmorphism, Geist typography.</p>
    </div>

    <!-- Colors -->
    <section id="colors" class="ds-section">
      <h2>Colors</h2>
      <div class="ds-grid">
        <div class="ds-swatch" style="background:#131313"><span class="ds-swatch-name">surface</span><span class="ds-swatch-hex">#131313</span></div>
        <div class="ds-swatch" style="background:#0e0e0e"><span class="ds-swatch-name">surface-dim</span><span class="ds-swatch-hex">#0e0e0e</span></div>
        <div class="ds-swatch" style="background:#3a3939"><span class="ds-swatch-name">surface-bright</span><span class="ds-swatch-hex">#3a3939</span></div>
        <div class="ds-swatch" style="background:#1c1b1b"><span class="ds-swatch-name">surface-container-low</span><span class="ds-swatch-hex">#1c1b1b</span></div>
        <div class="ds-swatch" style="background:#201f1f"><span class="ds-swatch-name">surface-container</span><span class="ds-swatch-hex">#201f1f</span></div>
        <div class="ds-swatch" style="background:#2a2a2a"><span class="ds-swatch-name">surface-container-high</span><span class="ds-swatch-hex">#2a2a2a</span></div>
        <div class="ds-swatch" style="background:#353534"><span class="ds-swatch-name">surface-container-highest</span><span class="ds-swatch-hex">#353534</span></div>
        <div class="ds-swatch" style="background:#353534"><span class="ds-swatch-name">surface-variant</span><span class="ds-swatch-hex">#353534</span></div>
        <div class="ds-swatch" style="background:#e5e2e1;color:#131313"><span class="ds-swatch-name">on-surface</span><span class="ds-swatch-hex">#e5e2e1</span></div>
        <div class="ds-swatch" style="background:#cfc2d7;color:#131313"><span class="ds-swatch-name">on-surface-variant</span><span class="ds-swatch-hex">#cfc2d7</span></div>
        <div class="ds-swatch" style="background:#dcb8ff;color:#131313"><span class="ds-swatch-name">primary</span><span class="ds-swatch-hex">#dcb8ff</span></div>
        <div class="ds-swatch" style="background:#8a2be2"><span class="ds-swatch-name">primary-container</span><span class="ds-swatch-hex">#8a2be2</span></div>
        <div class="ds-swatch" style="background:#bdf4ff;color:#131313"><span class="ds-swatch-name">secondary</span><span class="ds-swatch-hex">#bdf4ff</span></div>
        <div class="ds-swatch" style="background:#00e3fd;color:#131313"><span class="ds-swatch-name">secondary-container</span><span class="ds-swatch-hex">#00e3fd</span></div>
        <div class="ds-swatch" style="background:#ffb873;color:#131313"><span class="ds-swatch-name">tertiary</span><span class="ds-swatch-hex">#ffb873</span></div>
        <div class="ds-swatch" style="background:#935400"><span class="ds-swatch-name">tertiary-container</span><span class="ds-swatch-hex">#935400</span></div>
        <div class="ds-swatch" style="background:#988ca0;color:#131313"><span class="ds-swatch-name">outline</span><span class="ds-swatch-hex">#988ca0</span></div>
        <div class="ds-swatch" style="background:#4c4354"><span class="ds-swatch-name">outline-variant</span><span class="ds-swatch-hex">#4c4354</span></div>
        <div class="ds-swatch" style="background:#ffb4ab;color:#131313"><span class="ds-swatch-name">error</span><span class="ds-swatch-hex">#ffb4ab</span></div>
        <div class="ds-swatch" style="background:#93000a"><span class="ds-swatch-name">error-container</span><span class="ds-swatch-hex">#93000a</span></div>
      </div>
    </section>

    <!-- Typography -->
    <section id="typography" class="ds-section">
      <h2>Typography</h2>
      <div class="ds-type-grid">
        <div class="ds-type-card glass-panel">
          <div class="token-name">display-lg / Geist 64px w700</div>
          <p class="ds-type-sample" style="font-size:64px;font-weight:700;line-height:1.1;letter-spacing:-0.04em;margin:0;color:var(--obs-on-surface)">Display</p>
        </div>
        <div class="ds-type-card glass-panel">
          <div class="token-name">headline-lg / Geist 32px w600</div>
          <p class="ds-type-sample" style="font-size:32px;font-weight:600;line-height:1.2;letter-spacing:-0.02em;margin:0;color:var(--obs-on-surface)">Headline Large</p>
        </div>
        <div class="ds-type-card glass-panel">
          <div class="token-name">headline-lg-mobile / Geist 24px w600</div>
          <p class="ds-type-sample" style="font-size:24px;font-weight:600;line-height:1.2;margin:0;color:var(--obs-on-surface)">Headline Mobile</p>
        </div>
        <div class="ds-type-card glass-panel">
          <div class="token-name">body-md / Geist 16px w400</div>
          <p class="ds-type-sample" style="font-size:16px;font-weight:400;line-height:1.6;margin:0;color:var(--obs-on-surface)">Body text used for paragraphs, descriptions, and general content across all surfaces.</p>
        </div>
        <div class="ds-type-card glass-panel">
          <div class="token-name">label-caps / Geist 12px w600</div>
          <p class="ds-type-sample" style="font-size:12px;font-weight:600;line-height:1.0;letter-spacing:0.2em;text-transform:uppercase;margin:0;color:var(--obs-on-surface-variant)">SECTION LABEL / EYEBROW</p>
        </div>
        <div class="ds-type-card glass-panel">
          <div class="token-name">mono-code / JetBrains Mono 14px w400</div>
          <p class="ds-type-sample" style="font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:400;line-height:1.5;margin:0;color:var(--obs-on-surface)">code snippets, terminal, metadata</p>
        </div>
      </div>
    </section>

    <!-- Spacing -->
    <section id="spacing" class="ds-section">
      <h2>Spacing & Layout</h2>
      <div class="ds-spacing-grid" style="max-width:500px">
        <div class="ds-spacing-row"><span>grid_unit</span><div class="ds-spacing-bar" style="width:8px"></div><span>8px</span></div>
        <div class="ds-spacing-row"><span>gutter</span><div class="ds-spacing-bar" style="width:24px"></div><span>24px</span></div>
        <div class="ds-spacing-row"><span>margin_mobile</span><div class="ds-spacing-bar" style="width:20px"></div><span>20px</span></div>
        <div class="ds-spacing-row"><span>margin_desktop</span><div class="ds-spacing-bar" style="width:80px"></div><span>80px</span></div>
        <div class="ds-spacing-row"><span>container_max_width</span><span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-primary)">1200px</span></div>
      </div>
    </section>

    <!-- Components -->
    <section id="components" class="ds-section">
      <h2>Components</h2>
      <div class="ds-component-grid">
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">Glass Panel</div>
          <div style="width:100%;height:60px;border-radius:8px;background:rgba(32,31,31,0.4);backdrop-filter:blur(12px);border:1px solid rgba(76,67,84,0.3);display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">glass-panel:hover → purple glow</div>
        </div>
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">Terminal Button</div>
          <button class="terminal-btn">&gt; execute_command <span class="terminal-btn-cursor"></span></button>
        </div>
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">MacOS Window</div>
          <div style="width:100%;border-radius:8px;overflow:hidden;border:1px solid rgba(76,67,84,0.3)">
            <div class="macos-header">
              <div class="macos-dots">
                <span class="macos-dot red"></span>
                <span class="macos-dot yellow"></span>
                <span class="macos-dot green"></span>
              </div>
              <span style="flex:1;text-align:center;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--obs-on-surface-variant)">window.tsx</span>
              <div style="width:48px"></div>
            </div>
            <div style="padding:16px;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant);background:var(--obs-surface-container-low)">window content area</div>
          </div>
        </div>
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">Tech Chip</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap">
            <span class="bento-tag">TypeScript</span>
            <span class="bento-tag">React</span>
            <span class="bento-tag">Node.js</span>
          </div>
        </div>
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">Status Indicator</div>
          <div style="display:flex;gap:16px;align-items:center;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">
            <span style="display:flex;align-items:center;gap:8px">
              <span style="width:8px;height:8px;border-radius:50%;background:var(--obs-secondary);animation:pulse-glow 2s infinite;display:inline-block"></span>
              ONLINE
            </span>
            <span style="display:flex;align-items:center;gap:8px">
              <span style="width:8px;height:8px;border-radius:50%;background:var(--obs-primary);opacity:0.6;display:inline-block"></span>
              IDLE
            </span>
          </div>
        </div>
        <div class="ds-comp-demo glass-panel">
          <div class="ds-comp-title">Hero Text Gradient</div>
          <span class="text-gradient" style="font-size:32px;font-weight:700">Purple → Cyan</span>
        </div>
        <div class="ds-comp-demo glass-panel bento-hover-purple" style="cursor:default">
          <div class="ds-comp-title">Hover Glow (hover me)</div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">bento-hover-purple</span>
        </div>
        <div class="ds-comp-demo glass-panel bento-hover-cyan" style="cursor:default">
          <div class="ds-comp-title">Cyan Glow (hover me)</div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant)">bento-hover-cyan</span>
        </div>
      </div>
    </section>

    <!-- Design MD / Brand -->
    <section class="ds-section">
      <h2>Brand & Style</h2>
      <div class="glass-panel" style="padding:32px;border-radius:12px;max-width:800px">
        <p style="font-size:16px;line-height:1.6;color:var(--obs-on-surface-variant);margin:0 0 16px">
          Engineered for a high-end backend developer portfolio. The aesthetic sits at the intersection of <strong style="color:var(--obs-primary)">Minimalism</strong> and <strong style="color:var(--obs-secondary)">Glassmorphism</strong>, utilizing a "Dark Room" philosophy.
        </p>
        <p style="font-size:16px;line-height:1.6;color:var(--obs-on-surface-variant);margin:0 0 16px">
          The visual language evokes a high-performance IDE or a terminal environment. Relies on deep blacks, structural grids, and vibrant "data-stream" gradients.
        </p>
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--obs-on-surface-variant);background:var(--obs-surface-container-low);border:1px solid rgba(76,67,84,0.3);border-radius:8px;padding:16px;margin-top:16px">
          <div style="color:var(--obs-primary);margin-bottom:8px">$ Design DNA</div>
          <div>Primary: <span style="color:var(--obs-primary)">#8a2be2 (Neon Purple)</span></div>
          <div>Secondary: <span style="color:var(--obs-secondary)">#00e5ff (Electric Cyan)</span></div>
          <div>Neutral: <span style="color:var(--obs-on-surface)">#0a0a0a (Deep Obsidian)</span></div>
          <div>Font: Geist (body) + JetBrains Mono (code)</div>
          <div>Shape: 4px radius (standard), 12px (cards)</div>
        </div>
      </div>
    </section>
  </div>
</Obsidian>
